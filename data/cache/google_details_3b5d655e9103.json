        "profile_photo_url": "https://lh3.googleusercontent.com/a/ACg8ocKEmX3tHNR9X9asccSYcujc2eiFY9NxEld0Gu5S2tUpnWDOSA=s128-c0x00000000-cc-rp-mo",
