        "translated": true
      },
      {
        "author_name": "David Bernier",
        "author_url": "https://www.google.com/maps/contrib/107821942811821733486/reviews",
        "language": "en-US",
        "original_language": "fr",
        "profile_photo_url": "https://lh3.googleusercontent.com/a-/ALV-UjUYYwhBnd7GQ6XO6P4SFJNxU7igcDEg7EGxUJXqA1VDu5SxS01pqA=s128-c0x00000000-cc-rp-mo-ba3",
        "rating": 5,
        "relative_time_description": "5 years ago",
        "text": "It's a real pleasure to have access to someone so knowledgeable and professional who is nonetheless human in her approach! Diane is generous with her time, empathetic and extremely reassuring. I recommend her!!",
