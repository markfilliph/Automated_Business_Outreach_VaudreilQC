    "reviews": [
      {
        "author_name": "Sandra Carriero",
        "author_url": "https://www.google.com/maps/contrib/103184696866442563196/reviews",
        "language": "en",
        "original_language": "en",
        "profile_photo_url": "https://lh3.googleusercontent.com/a/ACg8ocIaOY9sjiDQ69khgwdbqab9HBYdSrrU5OV3DksVYVI3pKIM1g=s128-c0x00000000-cc-rp-mo-ba2",
        "rating": 5,
        "relative_time_description": "3 weeks ago",
        "text": "Our daughters have been attending Oxford Learning Center in Vaudreuil since they started early primary school, so it's been almost a decade.   Both attended an extremely competitive private school, and were attending Oxford to get supplementary help to keep up.  The team at Oxford is so professional and really are invested in making sure their students have the confidence to tackle their areas of improvement.  We would highly recommend their tutoring services to anyone wishing for a structured and positive environment where they can thrive.",
        "time": 1769191716,
        "translated": false
      },
      {
        "author_name": "Sarah T",
        "author_url": "https://www.google.com/maps/contrib/112404410769824865146/reviews",
        "language": "en",
        "original_language": "en",
        "profile_photo_url": "https://lh3.googleusercontent.com/a/ACg8ocLn7MtzDBqJnT_xIKAMYepTH-bow4XYAXQJB7877OENj5Heiw=s128-c0x00000000-cc-rp-mo",
        "rating": 5,
        "relative_time_description": "3 months ago",
        "text": "10/10 recommend Oxford Vaudreuil to anyone considering tutoring at any level, in any subject. Seamlessly managed by kind and compassionate staff, highly qualified tutors, excellent communication and incredibly understanding and accommodating all around. Excellent value.  We have had the BEST experience here; highly, highly recommend",
        "time": 1761702987,
        "translated": false
      },
      {
        "author_name": "Chloe Rivet",
        "author_url": "https://www.google.com/maps/contrib/100217784406535741136/reviews",
        "language": "en",
        "original_language": "en",
        "profile_photo_url": "https://lh3.googleusercontent.com/a-/ALV-UjVPSyH2D_djxBn2-1ktWEsKVw5UfsR6IPcNLVbiQuByM1--LoKB=s128-c0x00000000-cc-rp-mo",
        "rating": 5,
        "relative_time_description": "3 weeks ago",
        "text": "Great team that is invested in the kids and their families. My 7 year old daughter went from not able to read in her second language to reading fluently in it within 3 months with their help. Thank you!",
        "time": 1769222582,
        "translated": false
      },
      {
        "author_name": "June Herron",
        "author_url": "https://www.google.com/maps/contrib/102730237874593838273/reviews",
        "language": "en",
        "original_language": "en",
        "profile_photo_url": "https://lh3.googleusercontent.com/a/ACg8ocKyDYCScZKGDYgBArg0da3GICMcYAgnlrbF4o3lR8loiNEfdg=s128-c0x00000000-cc-rp-mo",
        "rating": 5,
        "relative_time_description": "3 weeks ago",
        "text": "Excellent experience that helped my son across the board with multiple subjects. It's amazing how knowledgeable they are.\nWould definitely recommend, for any subject.",
        "time": 1769214298,
        "translated": false
      },
      {
        "author_name": "Anita Rajnai",
        "author_url": "https://www.google.com/maps/contrib/111344501358392106950/reviews",
        "language": "en",
        "original_language": "en",
        "profile_photo_url": "https://lh3.googleusercontent.com/a/ACg8ocJS3oJXyi-Wmcps5NMenuZW8EI4x9_nEdxA9dnMjQNGqg2FJw=s128-c0x00000000-cc-rp-mo",
        "rating": 5,
        "relative_time_description": "11 months ago",
        "text": "I recently had an assessment experience at Oxford Learning Centre Vaudreuil and was thoroughly impressed by the professionalism and thoroughness of the process. The staff were welcoming and made the experience comfortable and engaging.\n\nThe assessment itself was comprehensive and well-structured, providing valuable insights into my child's strengths and areas for improvement. The team took the time to explain the results in detail, offering clear recommendations and a personalized learning approach tailored to my child's needs.\n\nOverall, the assessment process was a positive and enlightening experience. I would highly recommend Oxford Learning Centre Vaudreuil for their professionalism and dedication to helping students succeed.",
        "time": 1741811290,
        "translated": false
      }
