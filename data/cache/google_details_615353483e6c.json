    "reviews": [
      {
        "author_name": "William Taylor",
        "author_url": "https://www.google.com/maps/contrib/112370617020730746433/reviews",
        "language": "en",
        "original_language": "en",
        "profile_photo_url": "https://lh3.googleusercontent.com/a/ACg8ocI2i3n_0LyUY6auLzkOB1J3NgOEebDctC67F-fR9tZPAkwD1A=s128-c0x00000000-cc-rp-mo",
        "rating": 5,
        "relative_time_description": "3 months ago",
        "text": "Purchased a wood fireplace to replace my existing one.\nChristian the owner was very attentive to what l was looking for and he carefully explained the possible units that fit my needs. I settled on one and Christian offered me a rebate as new models were arriving shortly.\n\nMatthieu and his colleague removed the old unit and prefab chimney and installed a new unit and chimney. They were informative and happily answered my questions. However there was an issue with the positioning of the air intake vents (wall stud obstruction). Matthieu called the manufacturer and it was decided to make custom vents to fit in the location.\nThree weeks later Marie (owner) called to say the vents were in and what  colour did L want them painted.\nMatthieu and his colleague returned shortly afterward to finish the final installation and fan hook up.\nAll in all a pleasant experience.",
        "time": 1763407843,
        "translated": false
      },
      {
        "author_name": "Hank Johnson (Hankster)",
        "author_url": "https://www.google.com/maps/contrib/103574426570922879686/reviews",
        "language": "en",
        "original_language": "en",
        "profile_photo_url": "https://lh3.googleusercontent.com/a-/ALV-UjWXpFbhsXh67SU21hyxyzB_3hxGbjlNKR1-Y_m4pxBt0q_rscj-=s128-c0x00000000-cc-rp-mo-ba4",
        "rating": 5,
        "relative_time_description": "7 years ago",
        "text": "EXCELLENT service by Bertrand . Nice to go somewhere and the person knows there stuff. He is the Pellet stove specialist. Very polite and took time to hear what I wanted and gave good detailed explanations.  It's nice to go somewhere and they don't force a product on you.",
        "time": 1549322371,
        "translated": false
      },
      {
        "author_name": "Tyler yakimchuk",
        "author_url": "https://www.google.com/maps/contrib/104591803290575166758/reviews",
        "language": "en",
        "original_language": "en",
        "profile_photo_url": "https://lh3.googleusercontent.com/a/ACg8ocJD6Qbu4ay5nDCN_ike1RJWBb_JyK9P3XABwoRXcgX9xyGlDQ=s128-c0x00000000-cc-rp-mo",
        "rating": 5,
        "relative_time_description": "2 months ago",
        "text": "Excellent service from Marc. He took the time to make sure my gas fireplace was cleaned and in good working condition.",
        "time": 1765477527,
        "translated": false
      },
      {
        "author_name": "Terry B",
        "author_url": "https://www.google.com/maps/contrib/112381032740646769825/reviews",
        "language": "en",
        "original_language": "en",
        "profile_photo_url": "https://lh3.googleusercontent.com/a/ACg8ocJPLlmuiFfWZzjUYU46PnYmjDHmvWZ7ZjOPQzUc9_E0qHYhGg=s128-c0x00000000-cc-rp-mo",
        "rating": 5,
        "relative_time_description": "7 months ago",
        "text": "EXCELLENT SERVICE ...Very professional, knowledgable and courteous.  Their after sales service is exceptional.  I've also had fireplace cleaning and repair and was extremely satisfied.   I highly recommend them.",
        "time": 1753103607,
        "translated": false
      },
      {
        "author_name": "A G",
        "author_url": "https://www.google.com/maps/contrib/108846749161524958302/reviews",
        "language": "en",
        "original_language": "en",
        "profile_photo_url": "https://lh3.googleusercontent.com/a-/ALV-UjWtg-Bc9m7NE5jYmlXVrjpGxdXDO0Ra8KFmtzgq7h-dLPmo9Vlk=s128-c0x00000000-cc-rp-mo-ba3",
        "rating": 5,
        "relative_time_description": "6 months ago",
        "text": "Foyer Gaz were very helpful with installing my underground propane line during my landscaping and hardscaping excavation work even though I needed to get it planned and quoted during the construction holiday and installed right after. Thank you Marie and Marc.",
