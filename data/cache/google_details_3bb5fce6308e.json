    "reviews": [
      {
        "author_name": "Suryansh Anand",
        "author_url": "https://www.google.com/maps/contrib/106647103468674331930/reviews",
        "language": "en",
        "original_language": "en",
        "profile_photo_url": "https://lh3.googleusercontent.com/a-/ALV-UjWLAJAHKQQfPRbfeC_sHx-ec9ZSUk6VKdDRhaIoNZMg6Gp42cY=s128-c0x00000000-cc-rp-mo-ba4",
        "rating": 5,
        "relative_time_description": "a month ago",
        "text": "Apna Punjab Di Rasoi is my go-to place for groceries and Indian fast food. The quality is consistently great, the food tastes authentic, and the prices are fair.\n\nWhether I’m picking up daily groceries or grabbing a quick bite, I always leave satisfied.\nThe staff is friendly, respectful, and always willing to help.\n\nThe atmosphere feels welcoming and very community-oriented, which makes a big difference. You can tell they genuinely care about their customers.\n\nAs someone who works in digital services and helps local businesses grow through Asian Web Developers 🕉️, it’s always great to support hardworking local businesses like this that truly deserve visibility and success.\n\nHighly recommended for anyone looking for authentic Punjabi/Indian food and groceries in the area.",
        "time": 1767715732,
        "translated": false
      },
      {
        "author_name": "Amit Minhas",
        "author_url": "https://www.google.com/maps/contrib/104712907647929747071/reviews",
