      {
        "author_name": "Polina Faramazyan",
        "author_url": "https://www.google.com/maps/contrib/104733382322156226060/reviews",
        "language": "en-US",
        "original_language": "fr",
        "profile_photo_url": "https://lh3.googleusercontent.com/a/ACg8ocKxJ6kb0N787H_bnqs7P0C4HalyhJZOmJenCYGlJjrit9OkTh0=s128-c0x00000000-cc-rp-mo-ba2",
        "rating": 5,
        "relative_time_description": "2 years ago",
        "text": "This salon offers a warm welcome and professional, attentive service. Laurie is a hairdresser who has certainly perfected her craft! A huge thank you to her and her team for such a wonderful experience.",
        "time": 1695234821,
        "translated": true
      },
      {
        "author_name": "Mengyan W.",
        "author_url": "https://www.google.com/maps/contrib/107493019245041833423/reviews",
        "language": "en-US",
        "original_language": "fr",
        "profile_photo_url": "https://lh3.googleusercontent.com/a-/ALV-UjX0otFCaA4S0i5LQuuQ1uf7ytYxj6CYLVuwjXMXx2zq9d6Xlzc=s128-c0x00000000-cc-rp-mo",
        "rating": 5,
        "relative_time_description": "2 years ago",
        "text": "My hairdresser Laurie is amazing! It's been almost two years, and the cuts, highlights, blow-dries—everything is perfect! I recommend her to everyone.\n\nPlus, the atmosphere in the salon is always great; you can tell the girls love their work and they take good care of their clients!\n\nIn fact, the salon, the sinks, even the restrooms are always spotless.\nKudos to the team at Coiffure Maude Charbonneau!",
        "time": 1697898111,
        "translated": true
      }
