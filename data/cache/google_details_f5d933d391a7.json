        "profile_photo_url": "https://lh3.googleusercontent.com/a-/ALV-UjWlGw3CBEup7M4bgjaKSa-g0duuUD9r2q_PK4p03l_NfJU63TyG=s128-c0x00000000-cc-rp-mo",
        "rating": 5,
        "relative_time_description": "4 years ago",
        "text": "I've been a client for years. Great advice! Wonderful service! Highly recommend. I guess that's why I keep going back.",
