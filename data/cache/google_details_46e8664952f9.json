      {
        "author_name": "Sarah Jane Devoe",
        "author_url": "https://www.google.com/maps/contrib/111863841933913929429/reviews",
        "language": "en",
        "original_language": "en",
        "profile_photo_url": "https://lh3.googleusercontent.com/a-/ALV-UjU2EjtDqvsmeQsAwk5xIPkNDBdZBc7kO1CpsMWucObFhIiunkRF=s128-c0x00000000-cc-rp-mo-ba4",
        "rating": 5,
        "relative_time_description": "a year ago",
        "text": "LFG moved our family belongings to our new house this weekend and were quick and proficient. Nothing was broken in the move and they even moved my house plants safely. I`ve moved many times with the military and this has been by far the best company I`ve dealt with. 10/10 recommend and will use them again in the future.",
        "time": 1717093026,
        "translated": false
      },
      {
        "author_name": "Anthony Nevinglovschi",
        "author_url": "https://www.google.com/maps/contrib/114524360807972861230/reviews",
