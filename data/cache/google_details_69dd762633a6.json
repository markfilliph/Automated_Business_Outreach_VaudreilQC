        "original_language": "en",
        "profile_photo_url": "https://lh3.googleusercontent.com/a-/ALV-UjVKoag6d2ILUqu5WNs9vy2J_1b3VKGGsK1HNcwasDQoIMZkRRhI=s128-c0x00000000-cc-rp-mo-ba3",
        "rating": 5,
        "relative_time_description": "2 months ago",
        "text": "I was in a real bind visiting from out of town and these guys were able to have my tires switched out in a few hours. Great service, fast, definitely suggesting this place to my teams working out this way",
        "time": 1763575275,
        "translated": false
