        "profile_photo_url": "https://lh3.googleusercontent.com/a/ACg8ocLFCxUmhyI3hH3uPjghvuZx8uVMEOsV4YQR1yKnLAAGwKnmNQ=s128-c0x00000000-cc-rp-mo-ba4",
        "rating": 5,
        "relative_time_description": "5 years ago",
        "text": "This place is a bit less crowded than the ones on the island.  There is a queue anyway, but in the morning it's no more than 5 to 10 people, and barely any waiting.  Later in the day it gets longer fast.",
        "time": 1608475866,
        "translated": false
      },
