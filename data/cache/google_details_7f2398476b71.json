        "translated": true
      },
      {
        "author_name": "Robert Lauzon",
        "author_url": "https://www.google.com/maps/contrib/103347705379008727085/reviews",
        "language": "en-US",
        "original_language": "fr",
        "profile_photo_url": "https://lh3.googleusercontent.com/a/ACg8ocL5WUrCrHZhzCiiTUZND1_3fUT92ou7z2V70vzuFzzmiMDFRg=s128-c0x00000000-cc-rp-mo-ba3",
        "rating": 5,
        "relative_time_description": "3 months ago",
        "text": "Matelas Dauphin is Quebec's largest mattress manufacturer. In business since 1970, you'll find a range of exceptional quality products at manufacturer prices. Mattresses, complete beds, adjustable beds, pillows, sheets & accessories. The staff is courteous and professional. You'll be well guided through your purchase. Free delivery and removal of your old mattress if desired. Advantageous payment plans are available. An excellent destination for your next mattress purchase.",
        "time": 1761594742,
        "translated": true
      },
