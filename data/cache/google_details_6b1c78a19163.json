    "reviews": [
      {
        "author_name": "Chrystal McTurk",
        "author_url": "https://www.google.com/maps/contrib/118319936123536020015/reviews",
        "language": "en",
        "original_language": "en",
        "profile_photo_url": "https://lh3.googleusercontent.com/a-/ALV-UjX3baW5q1W4D8Y7TSC3L5fxAKh3qxsCoR4MnYw803t_ffIRYhaMlA=s128-c0x00000000-cc-rp-mo-ba2",
        "rating": 3,
        "relative_time_description": "3 months ago",
        "text": "The location is brightly lit and clean. There is an array of glasses frames to choose from. I was initially greeted by Guillaume, he has a warm and welcoming personality. I was able to find a frame right away with him.\nThe only complaint I have is that it took nearly 2 and a half months for them to attempt to get my lense prescriptions right. And in the end, I asked for a refund because it still was not right. In my 20 years of wearing glasses,  I have never had an issue before. This took up a lot of my time, gas, and energy.",
        "time": 1761708328,
        "translated": false
      },
      {
        "author_name": "Katoucha",
        "author_url": "https://www.google.com/maps/contrib/114644217356864108463/reviews",
        "language": "en",
        "original_language": "en",
        "profile_photo_url": "https://lh3.googleusercontent.com/a/ACg8ocK7WunBpoSK_kMi6RRzRqXyev3_LILkH5gpSBET8j2cB2Qbmw=s128-c0x00000000-cc-rp-mo",
        "rating": 5,
        "relative_time_description": "3 weeks ago",
        "text": "Excellent service, great explanations. Overall very satisfied with the experience. I will now change from my former provider to Optical center.",
        "time": 1769087026,
        "translated": false
      },
      {
        "author_name": "Asha R",
        "author_url": "https://www.google.com/maps/contrib/110103583236912913712/reviews",
        "language": "en",
        "original_language": "en",
        "profile_photo_url": "https://lh3.googleusercontent.com/a/ACg8ocKE9gsxjWOXI75BaWpmMyM88gtgglDvVwfDWgAGwGqX49SCmbk=s128-c0x00000000-cc-rp-mo-ba2",
        "rating": 5,
        "relative_time_description": "5 months ago",
        "text": "I had an outstanding experience with Beverly at the optician center. It was my first visit, and she went above and beyond to adjust my sunglasses free of charge. She ensured they fit perfectly and comfortably, and her professionalism and friendly demeanor made the whole process a breeze. Highly recommend her service!",
        "time": 1756231778,
        "translated": false
      },
      {
        "author_name": "Stefano Gissi",
