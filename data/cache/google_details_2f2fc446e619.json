        "translated": false
      },
      {
        "author_name": "Gary Machado",
        "author_url": "https://www.google.com/maps/contrib/105547796614339530689/reviews",
        "language": "en",
        "original_language": "en",
        "profile_photo_url": "https://lh3.googleusercontent.com/a-/ALV-UjUJWDp3MY_RJR520emno9rE8LdSLNEIEhD245gjj0foMhUcKun2hQ=s128-c0x00000000-cc-rp-mo-ba6",
        "rating": 4,
        "relative_time_description": "4 years ago",
        "text": "COVID19 safety protocols are enforced in the entrance. You must book an appointment online first, which is pretty easy. Not crowded when compared to the West Island. Staff is friendly and fully bilingual. Before the pandemic there was waiting times but nothing unbearable.",
