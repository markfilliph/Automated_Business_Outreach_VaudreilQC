    "reviews": [
      {
        "author_name": "Lindsay E McLeod",
        "author_url": "https://www.google.com/maps/contrib/102366879950606396090/reviews",
        "language": "en",
        "original_language": "en",
        "profile_photo_url": "https://lh3.googleusercontent.com/a/ACg8ocISQpBMWM0yKFa7gQw2O5_wI9bVjSJKyr7pX-liPUQPs7dMDA=s128-c0x00000000-cc-rp-mo-ba3",
        "rating": 5,
        "relative_time_description": "a year ago",
        "text": "Annika is an incredibly talented artist and teacher. I own one of her delicate watercolours (hanging prominently in my home) but she was also an inspiring art teacher for my daughter (now a professional artist) for 6 years! I highly recommend her art school!",
        "time": 1728157280,
        "translated": false
      },
      {
        "author_name": "Tara Bissett",
        "author_url": "https://www.google.com/maps/contrib/107501907425487530186/reviews",
        "language": "en",
        "original_language": "en",
        "profile_photo_url": "https://lh3.googleusercontent.com/a-/ALV-UjUUbdnTbv9IpLqi7CpNmNNo5f3bgMWl-rYjfnvJntH7v0i71Aki=s128-c0x00000000-cc-rp-mo",
        "rating": 5,
        "relative_time_description": "a year ago",
        "text": "I can't recommend Annika enough. She clearly loves what she does, - My daughter had a blast creating art in her studio. Annika's got a patient, inspiring demeanour and creative, fun class project ideas. We'll be taking future classes - highly recommend. (*Also as an artist, her work is exquisite!!)",
        "time": 1728253697,
        "translated": false
      },
      {
        "author_name": "Autumn Hiscock",
        "author_url": "https://www.google.com/maps/contrib/114389317475460747489/reviews",
        "language": "en",
        "original_language": "en",
        "profile_photo_url": "https://lh3.googleusercontent.com/a-/ALV-UjXZhMDqP-O2ZxCfjvoZp2hwuhPYGSt-eD0o9O0vh9wW9yB7iPVP=s128-c0x00000000-cc-rp-mo",
        "rating": 5,
        "relative_time_description": "a year ago",
        "text": "I own several of Annika’s original artworks. Her style is so evocative, touches the heart, and makes me smile every time I see one of her pieces. I love her use of colour. Commissions have been handled with kindness and professionalism, shipping has been quick and very well packed, and communication excellent. She is a pleasure to deal with.",
        "time": 1728235110,
        "translated": false
      },
      {
        "author_name": "Rob St-Martin",
        "author_url": "https://www.google.com/maps/contrib/112631169792185304920/reviews",
        "language": "en",
        "original_language": "en",
        "profile_photo_url": "https://lh3.googleusercontent.com/a-/ALV-UjUyiV5sgv1Hc0qIg7o4x-rv3LzstbMZJnVh3oMq5-Z3o1s0IQBk=s128-c0x00000000-cc-rp-mo",
        "rating": 5,
        "relative_time_description": "a year ago",
        "text": "Wonderful artist with a quirky sense of humour, inspiring, positive, and supportive teacher, gorgeous paintings. Everything you could ask for in an art teacher and artist!",
        "time": 1728174164,
        "translated": false
      }
