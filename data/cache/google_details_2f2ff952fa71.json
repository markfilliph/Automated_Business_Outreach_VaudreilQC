    "reviews": [
      {
        "author_name": "Jonathan Lavy",
        "author_url": "https://www.google.com/maps/contrib/105977041884052614439/reviews",
        "language": "en",
        "original_language": "en",
        "profile_photo_url": "https://lh3.googleusercontent.com/a-/ALV-UjXrgwkLmj7PgETFjPDsyImbbBlf6v5_AooNJkH8k_5abT-z5pWZ=s128-c0x00000000-cc-rp-mo-ba4",
        "rating": 5,
        "relative_time_description": "2 months ago",
        "text": "I had an amazing experience with Sarah. She is an amazing massage therapist and I thoroughly enjoyed my first appointment with her and will be back. She is unfortunately far from central Montreal (45 minutes without traffic) but it is highly worth your time! Sarah was attentive to my needs and also incorporated cupping therapy during my massage to ease my tightness in my quad muscles, specifically. I took a 90 minute appointment which I recommend for a fully body session to ensure your needs are met. Couldn't be happier and I will be a repeat customer.",
        "time": 1763651074,
        "translated": false
      },
      {
        "author_name": "Rajan Sareen",
        "author_url": "https://www.google.com/maps/contrib/108278418878837220828/reviews",
        "language": "en",
        "original_language": "en",
        "profile_photo_url": "https://lh3.googleusercontent.com/a-/ALV-UjVWyuge5_YGN4H3S0qAyjBmIeyrb0DELlrtrNKmah-iOFAPGvk=s128-c0x00000000-cc-rp-mo-ba4",
        "rating": 5,
        "relative_time_description": "2 months ago",
        "text": "Jessica is amazing she took her time to understand and assess my situation. Her treatment is excellent. She really took her time and hit each point. She is not like other Physio. Where first off all they charge you a lot and out of 30 minutes they put you on machine for 15 minutes .... and some time they forget about you . Jessica doesn't have any machine its all with her hands ...\nI recommend everyone to go there... and you will feel very good.....",
        "time": 1764332046,
        "translated": false
      },
      {
        "author_name": "Nancy Peterson",
        "author_url": "https://www.google.com/maps/contrib/116771051970581970466/reviews",
        "language": "en",
        "original_language": "en",
        "profile_photo_url": "https://lh3.googleusercontent.com/a-/ALV-UjUYe_0D0TF0YXIHWQZuD1MOoY4n74k-aiIk79af9QEWAuqW0ED2BQ=s128-c0x00000000-cc-rp-mo",
        "rating": 5,
        "relative_time_description": "a month ago",
        "text": "Sarah is an amazing massage therapist, really listens to your needs and concerns.\nSuch ana amazing experience, highly recommend",
        "time": 1767988671,
        "translated": false
      },
      {
        "author_name": "Claude Beauregard",
        "author_url": "https://www.google.com/maps/contrib/106323130063711429952/reviews",
        "language": "en",
        "original_language": "en",
        "profile_photo_url": "https://lh3.googleusercontent.com/a/ACg8ocKbspP2_Mvk-7T26Tpdfxir7vU9i8WriBdMHS3k0GtpJSGP7A=s128-c0x00000000-cc-rp-mo",
        "rating": 5,
        "relative_time_description": "4 months ago",
        "text": "I can't say enough good things about Jessica. From my very first appointment, she made me feel comfortable and listened to all of my concerns. She created a personalized treatment plan that was easy to follow and explained every exercise clearly. She's incredibly knowledgeable and patient, and thanks to her, I've made remarkable progress. If you're looking for a skilled and compassionate physiotherapist, Jessica is the one to see.",
        "time": 1758393351,
        "translated": false
      },
      {
        "author_name": "Melissa Simboli-Gibbs",
        "author_url": "https://www.google.com/maps/contrib/110227900747341082096/reviews",
        "language": "en",
        "original_language": "en",
        "profile_photo_url": "https://lh3.googleusercontent.com/a-/ALV-UjXpUCKdHXnyd0op-XleoS-UYQJrGZLRJOQejkJgK80Q7U9FmpBj=s128-c0x00000000-cc-rp-mo",
        "rating": 5,
        "relative_time_description": "2 months ago",
        "text": "Jess and Sarah are passionate, knowledgable professionals who make every appointment feel personal and warm. Really appreciate Jess’ approach and her recommendations for exercises to do at home even if you have little time as well as how to adopt good habits for back issues with a typical 9-5 office life!",
        "time": 1763583874,
        "translated": false
