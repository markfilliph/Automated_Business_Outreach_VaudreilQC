        "profile_photo_url": "https://lh3.googleusercontent.com/a/ACg8ocLLojsx8HVkFSS-RLINxGz0JmpmLuiNe07Zhrx-tXgfnk61ww=s128-c0x00000000-cc-rp-mo",
        "rating": 5,
        "relative_time_description": "5 years ago",
        "text": "Very happy with the installation of our new frost fence. This is our 2nd time using Clotures Raymond. Their employees are respectful in keeping your property clean, the work is well executed, and was finished on time. Thank you again for another great job.",
        "time": 1589568314,
        "translated": false
      },
