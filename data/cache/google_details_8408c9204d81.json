    "reviews": [
      {
        "author_name": "Stephanie",
        "author_url": "https://www.google.com/maps/contrib/102409052423244395134/reviews",
        "language": "en",
        "original_language": "en",
        "profile_photo_url": "https://lh3.googleusercontent.com/a-/ALV-UjWVGwBs33f_vtBgI584Uy0e_xEu043s46jGOk1Ejf6XQ3L-6O0SUA=s128-c0x00000000-cc-rp-mo-ba3",
        "rating": 5,
        "relative_time_description": "a month ago",
        "text": "Absolutely amazing service at Matelas Bonheur!\nFrom the moment we walked in, we were welcomed with professionalism, patience, and genuine kindness. One of the salesmen assisted us directly and was extremely knowledgeable, attentive, and took the time to answer all our questions without any pressure.\nBoth gentlemen were very pleasant and professional, which made the entire experience even better. Outstanding customer service like this is rare and truly appreciated.\nWith such a positive experience, they might even become future clients at my dog grooming salon!\nHighly recommend Matelas Bonheur",
        "time": 1766783468,
        "translated": false
      },
      {
        "author_name": "Lisa Burns",
        "author_url": "https://www.google.com/maps/contrib/104534261241075274784/reviews",
        "language": "en",
        "original_language": "en",
        "profile_photo_url": "https://lh3.googleusercontent.com/a-/ALV-UjU_W0c2D9syCCjoaxr8usYvM4cR2c8hdPfkzNomUqC8dYm0YvM=s128-c0x00000000-cc-rp-mo",
        "rating": 5,
        "relative_time_description": "3 months ago",
        "text": "Pat the salesman at the Vaudreuil store is simply excellent! Knowledgeable and friendly. He stays in your budget. You can feel he wants you to be satisfied! No overselling or pressure. Matelas Bonheur is the best! Old fashioned great service!\nDelivery guys were also excellent and went above and beyond !",
        "time": 1763047276,
        "translated": false
      },
