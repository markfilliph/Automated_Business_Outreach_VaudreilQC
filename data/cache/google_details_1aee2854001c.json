    "reviews": [
      {
        "author_name": "Debbie Bowden",
        "author_url": "https://www.google.com/maps/contrib/115683622911442127181/reviews",
        "language": "en",
        "original_language": "en",
        "profile_photo_url": "https://lh3.googleusercontent.com/a/ACg8ocLyA3014rg4qbGvD1lTrsZY-2O3o--ScFL76613jpikVUYO1Q=s128-c0x00000000-cc-rp-mo",
        "rating": 5,
        "relative_time_description": "5 months ago",
        "text": "We would definitely highly recommend Eric Dutton's company.\nHe gave us a quick response, quote and the work was completed within 2 weeks. The team of Seb & Cedric were efficient, professional and cleaned up everything.\nExcellent job completed in the time frame promised.\nThank you, Eric & team for the great service !",
        "time": 1756253518,
        "translated": false
      },
      {
        "author_name": "P Roso",
        "author_url": "https://www.google.com/maps/contrib/116430523099487392271/reviews",
        "language": "en",
        "original_language": "en",
        "profile_photo_url": "https://lh3.googleusercontent.com/a-/ALV-UjWJsi5Q2VWO8Oupr981wBbJgaHKezaEVEC0oc4YE477oxyQgZjO=s128-c0x00000000-cc-rp-mo",
        "rating": 5,
        "relative_time_description": "11 months ago",
        "text": "5yrs ago he did our house in St. Lazare and we're happy with it and 2 yrs ago he did our Vaudreuil house. We have some questions about our attic and Right away Eric said that Pascal will check it for us in and answered our questions.. We are so grateful for the nice service and after service. Very professional, honest and helpful. If there's a 10 star I will give it.",
        "time": 1742478539,
        "translated": false
      },
      {
        "author_name": "Olga Schroeder",
        "author_url": "https://www.google.com/maps/contrib/102863360262341828110/reviews",
        "language": "en",
        "original_language": "en",
        "profile_photo_url": "https://lh3.googleusercontent.com/a/ACg8ocJ-EzaDzkH8aoUpdU65yIsrcHytgTSuGXDzmw-IanT0Mo30WQ=s128-c0x00000000-cc-rp-mo",
        "rating": 5,
        "relative_time_description": "8 months ago",
        "text": "I highly recommend Eric Dutton Insulation! I would recommend them to anyone in need of insulation or home energy efficiency services. They are honest, knowledgeable, reliable, and also very friendly. A truly five-star experience!",
        "time": 1750507450,
        "translated": false
      },
      {
        "author_name": "Bryan Todd",
        "author_url": "https://www.google.com/maps/contrib/101360680772506428471/reviews",
        "language": "en",
        "original_language": "en",
        "profile_photo_url": "https://lh3.googleusercontent.com/a/ACg8ocKldqS5b2eyv4aLKchJ0yndrD1XceKXyDaup-9RwdH4BU4tkA=s128-c0x00000000-cc-rp-mo",
        "rating": 5,
        "relative_time_description": "2 years ago",
        "text": "Eric Dutton and his crew have done an amazing job for my Insulation needs.\nHis  crew were extremely knowledgeable, professional and very friendly.\nThey answered all my questions and did excellent work.\nEric did something else very special for me . He was able to put in the extra time to start and finish the work  so that my 19 year old daughter who had spent the last 8 months in the hospital battling Leukemia was to be able to come home for Father’s Day.\nWow…not only does Eric have a great company, but also a heart of gold!!\nIf you need an insulation job well done at competitive prices, he is someone you can trust !!",
        "time": 1687260507,
        "translated": false
      },
      {
        "author_name": "Gary Harvey",
        "author_url": "https://www.google.com/maps/contrib/109692706387219266903/reviews",
        "language": "en",
        "original_language": "en",
        "profile_photo_url": "https://lh3.googleusercontent.com/a/ACg8ocKu2BFqjmKIKCr77l4FDre8V49vMESGqGZ5I_t-XN2A9DUOmQ=s128-c0x00000000-cc-rp-mo",
        "rating": 5,
        "relative_time_description": "a year ago",
        "text": "We hired Dutton Insulation to top up our attic insulation and insert attic baffles. Eric was great in answering email and phone questions before the work was done, and pricing was very reasonable. The crew of Sebastien and Cedric also explained everything as they worked, and did a great job, including cleanup. Highly recommend.",
        "time": 1709779289,
        "translated": false
      }
