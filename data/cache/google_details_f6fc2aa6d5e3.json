      },
      {
        "author_name": "Andrew L",
        "author_url": "https://www.google.com/maps/contrib/104098188375684238999/reviews",
        "language": "en",
        "original_language": "en",
        "profile_photo_url": "https://lh3.googleusercontent.com/a/ACg8ocKejwtqOVQvsTWBcjbNiWCQrB_MenV7m43ZoIPOhUTT4mi6Gw=s128-c0x00000000-cc-rp-mo-ba4",
        "rating": 5,
        "relative_time_description": "2 years ago",
        "text": "This pharmacy is fantastic. We booked a strep test through clic sante for our daughter. Our doctor had given us a prescription for antibiotics in case the test came back positive. Our appointment was at 10am and we were 10 minutes early and they took us right away. They told us the test results would take 10-15 minutes for the results and offered for us to wait in the car and they would call us with the results. They called us not even 10 minutes later letting us know it was positive, they had already prepared the medication. Very efficient process. Keep up the great work.",
        "time": 1702136312,
        "translated": false
      }
